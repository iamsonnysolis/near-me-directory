# Environment variables for near-me-directory (local development)
# Copy from .env.example and fill in your values

# Site configuration
PUBLIC_SITE_URL=https://nearme.directory
SITE_NAME=Near Me Directory
SITE_TAGLINE=Find public listings near you
TWITTER_HANDLE=@nearmedirectory
CONTACT_EMAIL=hello@nearme.directory

# Google Analytics (optional)
GA_MEASUREMENT_ID=G-BJ1CGF615G

# Cloudflare settings (for wrangler dev)
CF_ACCOUNT_ID=your-account-id-here
CF_API_TOKEN=your-api-token-here

# D1 Database (local)
# In development, wrangler dev provides DB binding automatically
# In production, the binding is configured in wrangler.toml
