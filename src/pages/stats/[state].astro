---
// /stats/[state] - State Statistics page
export const revalidate = 604800;
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import StatTile from '../../components/stats/StatTile.astro';
import InsightCallout from '../../components/stats/InsightCallout.astro';
import GradeBadge from '../../components/stats/GradeBadge.astro';
import RankBadge from '../../components/stats/RankBadge.astro';
import { getEntityStats, getEntityRankings, getAvailableVersions } from '../../lib/stats';
import {
  formatCount, formatPct, formatVersion, formatRank,
  stateName, minsToTime, scoreToGradeDisplay, FEATURE_TAXONOMY, listFeatureSlugs, topicColorClasses,
} from '../../lib/stats-utils';

export async function getStaticPaths() {
  const STATE_CODES = ['nsw', 'vic', 'qld', 'wa', 'sa', 'tas', 'act', 'nt'];
  return STATE_CODES.map((s) => ({ params: { state: s } }));
}

const { state } = Astro.params;
const stateCode = state as string;
const stats = await getEntityStats('state', stateCode);
const stateDisplayName = stateName(stateCode);
const availableVersions = await getAvailableVersions();

// Top regions within this state, by facility count. entity_id is stored as
// "{slug}-{state}" (e.g. "bayside-vic") to stay unique nationally; strip the
// state suffix back off to build the real site route /vic/bayside.
const regionsInState = await getEntityRankings('region', 'listing_count', { stateCode });
const topRegions = regionsInState
  .slice()
  .sort((a, b) => (b.value || 0) - (a.value || 0))
  .slice(0, 10)
  .map((r) => {
    const suffix = `-${stateCode.toLowerCase()}`;
    const bareSlug = r.entity_id.endsWith(suffix) ? r.entity_id.slice(0, -suffix.length) : r.entity_id;
    return { ...r, bareSlug };
  });

const sourceVersion = stats?.listing_count?.source_version;
const year = (sourceVersion || '').split('-')[0] || ('' + new Date().getFullYear());

// SEO metadata
const title = `Public Facilities in ${stateDisplayName} — Statistics ${year} | Near Me Directory`;
const description = `${stateDisplayName} has ${formatCount(stats?.listing_count?.value)} public listings. ${formatPct(stats?.accessible_pct?.value)} are wheelchair accessible, ranking ${formatRank(stats?.accessible_pct?.rank, stats?.accessible_pct?.rank_of)} in Australia.`;

// Full metric breakdown, driven by the same taxonomy the feature pages use —
// add a feature to FEATURE_TAXONOMY and it appears here automatically.
const featureBreakdown = listFeatureSlugs().map((slug) => {
  const f = FEATURE_TAXONOMY[slug];
  const countStat = stats?.[f.countMetric];
  const pctStat = f.pctMetric ? stats?.[f.pctMetric] : null;
  return {
    ...f,
    count: countStat?.value ?? 0,
    pct: pctStat?.value ?? null,
    rank: pctStat?.rank ?? countStat?.rank ?? null,
    rankOf: pctStat?.rank_of ?? countStat?.rank_of ?? null,
  };
});

const scores = [
  { key: 'accessibility_score', label: 'Accessibility', color: 'blue', description: 'Accessible listings, Changing Places, and MLAK coverage.' },
  { key: 'family_score', label: 'Family', color: 'teal', description: 'Baby change, baby care rooms, accessible parking.' },
  { key: 'traveller_score', label: 'Traveller', color: 'amber', description: 'Dump points, 24-hour access, and showers.' },
  { key: 'provision_score', label: 'Provision', color: 'purple', description: 'Overall listings and accessible listings per capita.' },
].map((s) => ({ ...s, value: stats?.[s.key]?.value ?? 0, classes: topicColorClasses(s.color) }));
---

<Layout metadata={{ title, description, canonical: 'https://facilitiesnearme.com.au/stats/' + stateCode }}>

  <!-- SECTION 1 — State Hero Tiles -->
  <section class="bg-gradient-to-b from-blue-50 to-white py-12">

      <!-- Breadcrumbs -->
      <nav class="container mx-auto px-4 pb-4 text-sm text-gray-500" aria-label="Breadcrumb">
        <a href="/" class="hover:underline text-gray-600">Home</a>
        <span class="mx-1.5">/</span>
        <a href="/stats" class="hover:underline text-gray-600">Stats</a>
        <span class="mx-1.5">/</span>
        <span class="text-gray-700 font-medium">{stateDisplayName}</span>
      </nav>

    <div class="container mx-auto px-4">
      <h1 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">Public Listing Statistics — {stateDisplayName}</h1>
      <p class="text-gray-600 mb-6">{formatCount(stats?.listing_count?.value)} facilities, ranking {formatRank(stats?.listing_count?.rank, stats?.listing_count?.rank_of)} nationally by total count.</p>
      <div class="grid grid-cols-2 md:grid-cols-3 gap-4 my-6">
        <StatTile
          value={formatPct(stats?.accessible_pct?.value)}
          label="Accessible"
          sublabel={formatRank(stats?.accessible_pct?.rank, stats?.accessible_pct?.rank_of)}
          href="/stats/features/accessible"
          topic="primary"
        />
        <StatTile
          value={formatPct(stats?.baby_change_pct?.value)}
          label="Baby Change"
          sublabel={formatRank(stats?.baby_change_pct?.rank, stats?.baby_change_pct?.rank_of)}
          href="/stats/features/baby-change"
          topic="family"
        />
        <StatTile
          value={formatPct(stats?.open_24h_pct?.value)}
          label="Open 24hrs"
          sublabel={formatRank(stats?.open_24h_pct?.rank, stats?.open_24h_pct?.rank_of)}
          href="/stats/features/open-24h"
          topic="hours"
        />
      </div>
    </div>
  </section>

  <!-- SECTION 2 — Opening Finding -->
  <section class="py-8 bg-white">
    <div class="container mx-auto px-4">
      <InsightCallout topic="primary">
        <p class="font-semibold mb-1">
          {stateDisplayName} has {formatCount(stats?.accessible_count?.value)} accessible listings — {formatPct(stats?.accessible_pct?.value)} of all facilities.
        </p>
        <p class="text-gray-700">
          For visitors with mobility requirements, always check individual facility details before visiting.
        </p>
      </InsightCallout>
    </div>
  </section>

  <!-- SECTION 3 — National Ranks -->
  <section class="py-8 bg-gray-50">
    <div class="container mx-auto px-4">
      <h2 class="text-2xl font-bold text-gray-900 mb-4">{stateDisplayName} ranks nationally</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="flex justify-between items-center py-2 px-3 bg-blue-50 rounded">
          <span class="text-gray-700">Accessible %</span>
          <RankBadge rank={stats?.accessible_pct?.rank} total={stats?.accessible_pct?.rank_of ?? 8} />
        </div>
        <div class="flex justify-between items-center py-2 px-3 bg-teal-50 rounded">
          <span class="text-gray-700">Baby change %</span>
          <RankBadge rank={stats?.baby_change_pct?.rank} total={stats?.baby_change_pct?.rank_of ?? 8} />
        </div>
        <div class="flex justify-between items-center py-2 px-3 bg-amber-50 rounded">
          <span class="text-gray-700">24h %</span>
          <RankBadge rank={stats?.open_24h_pct?.rank} total={stats?.open_24h_pct?.rank_of ?? 8} />
        </div>
        <div class="flex justify-between items-center py-2 px-3 bg-purple-50 rounded">
          <span class="text-gray-700">Facilities per 10k people</span>
          <RankBadge rank={stats?.facilities_per_10k?.rank} total={stats?.facilities_per_10k?.rank_of ?? 8} />
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 4 — Full Feature Breakdown (driven by FEATURE_TAXONOMY) -->
  <section class="py-8 bg-white">
    <div class="container mx-auto px-4">
      <h2 class="text-2xl font-bold text-gray-900 mb-4">Full breakdown</h2>
      <div class="grid md:grid-cols-2 gap-3">
        {featureBreakdown.map((f) => (
          <a href={`/stats/features/${f.slug}`} class="flex items-center justify-between py-3 px-4 bg-gray-50 hover:bg-gray-100 rounded-lg transition-colors">
            <span class="text-gray-800 font-medium">{f.shortLabel}</span>
            <span class="text-sm text-gray-600">
              {formatCount(f.count)}{f.pct !== null ? ` (${formatPct(f.pct)})` : ''}
              {f.rank ? <span class="text-gray-400 ml-2">{formatRank(f.rank, f.rankOf)}</span> : null}
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- SECTION 5 — Opening Hours detail -->
  <section class="py-8 bg-gray-50">
    <div class="container mx-auto px-4">
      <h2 class="text-2xl font-bold text-gray-900 mb-4">Opening hours</h2>
      <ul class="space-y-1 text-gray-700">
        <li>Open past 10pm: {formatCount(stats?.open_after_10pm_count?.value)}</li>
        <li>Average daily hours: {stats?.avg_open_hours_per_day?.value ? `${stats.avg_open_hours_per_day.value} hrs` : '—'}</li>
        <li>Average closing time: {minsToTime(stats?.avg_closing_time?.value) || '—'}</li>
        <li>Open on weekends: {formatPct(stats?.open_weekend_pct?.value)} ({formatCount(stats?.open_weekend_count?.value)} facilities)</li>
      </ul>
    </div>
  </section>

  <!-- SECTION 6 — Per Capita -->
  <section class="py-8 bg-white">
    <div class="container mx-auto px-4">
      <h2 class="text-2xl font-bold text-gray-900 mb-4">Per capita comparison</h2>
      <p class="text-gray-700 mb-2">
        {stateDisplayName} has {formatCount(stats?.facilities_per_10k?.value)} public listings per 10,000 residents
        {stats?.people_per_facility?.value ? ` — about one for every ${formatCount(stats.people_per_facility.value)} people.` : '.'}
      </p>
      <p class="text-gray-700">
        Of those, {formatCount(stats?.accessible_per_10k?.value)} per 10,000 residents are wheelchair accessible.
      </p>
    </div>
  </section>

  <!-- SECTION 7 — Scores Summary -->
  <section class="py-8 bg-gray-50">
    <div class="container mx-auto px-4">
      <h2 class="text-2xl font-bold text-gray-900 mb-4">How {stateDisplayName} scores</h2>
      <div class="grid md:grid-cols-2 gap-6">
        {scores.map((s) => {
          const gradeInfo = scoreToGradeDisplay(s.value);
          return (
            <div class="bg-white rounded-lg p-4 border">
              <div class="flex items-center justify-between mb-2">
                <span class="font-semibold">{s.label}</span>
                <span class="flex items-center gap-2">
                  <span class="text-2xl font-bold">{s.value}</span>
                  <GradeBadge grade={gradeInfo.grade} color={gradeInfo.color} />
                </span>
              </div>
              <div class="w-full bg-gray-200 rounded-full h-3 mb-2">
                <div class={`${s.classes.bar} h-full rounded-full`} style={`width: ${Math.min(100, s.value)}%`}></div>
              </div>
              <p class="text-xs text-gray-600">{s.description}</p>
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <!-- SECTION 8 — Regions in this state -->
  {topRegions.length > 0 && (
    <section class="py-8 bg-white">
      <div class="container mx-auto px-4">
        <h2 class="text-2xl font-bold text-gray-900 mb-4">Regions in {stateDisplayName}</h2>
        <p class="text-gray-600 mb-3 text-sm">Local government areas with the most facilities.</p>
        <div class="bg-gray-50 rounded-lg border border-gray-200 divide-y divide-gray-200">
          {topRegions.map((r, i) => (
            <a href={`/${stateCode.toLowerCase()}/${r.bareSlug}`} class="flex items-center justify-between py-3 px-4 hover:bg-gray-100 transition-colors">
              <span class="text-gray-800"><span class="text-gray-400 mr-2">{i + 1}.</span>{r.metadata?.region_name || r.bareSlug}</span>
              <span class="text-sm font-semibold text-gray-700">{formatCount(r.value)} listings</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- SECTION 9 — Link Back -->
  <section class="py-8 bg-gray-50">
    <div class="container mx-auto px-4">
      <a href="/stats" class="text-sm text-blue-600 hover:text-blue-800 font-medium">See how {stateDisplayName} compares to other states &rarr;</a>
    </div>
  </section>

  <!-- Methodology -->
  <section class="py-8 bg-white">
    <div class="container mx-auto px-4">
      <h2 class="text-2xl font-bold text-gray-900 mb-4">About this data</h2>
      <p class="text-gray-700 mb-4">
        Data sourced from the National Public Listing Map, published by the Australian Department of Health.
      </p>
      <p class="text-gray-600 text-sm">Last updated: {formatVersion(sourceVersion)}</p>
    </div>
  </section>

  <!-- Year History -->
  <section class="py-8 bg-gray-50">
    <div class="container mx-auto px-4 text-center">
      <p class="text-xs text-gray-500 mb-2">Previous data releases:</p>
      <div class="flex justify-center gap-4 text-xs">
        {availableVersions.filter((v) => v !== sourceVersion).map((v) => (
          <a href={`?version=${v}`} class="text-gray-600 hover:underline">{formatVersion(v)}</a>
        ))}
      </div>
    </div>
  </section>
</Layout>
