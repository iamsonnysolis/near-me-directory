---
// /stats/features/[feature] - Dynamic feature comparison page
// Replaces the old one-file-per-feature pages (accessibility.astro, caravans.astro,
// 24-hours.astro, families.astro, changing-places.astro). One template, driven by
// FEATURE_TAXONOMY, framed around the audience who actually needs that feature.
export const revalidate = 604800;
export const prerender = true;

import Layout from '../../../layouts/Layout.astro';
import StatTile from '../../../components/stats/StatTile.astro';
import InsightCallout from '../../../components/stats/InsightCallout.astro';
import { getNationStats, getEntityRankings, getAvailableVersions } from '../../../lib/stats';
import {
  formatCount, formatPct, formatVersion, formatPerCapita, formatRank,
  stateName, FEATURE_TAXONOMY, listFeatureSlugs, getFeatureDefinition, topicColorClasses,
} from '../../../lib/stats-utils';

export async function getStaticPaths() {
  return listFeatureSlugs().map((feature) => ({ params: { feature } }));
}

const { feature: featureSlug } = Astro.params;
const feature = getFeatureDefinition(featureSlug as string);

if (!feature) {
  return new Response(null, { status: 404 });
}

const TOPIC_COLOR: Record<string, string> = { primary: 'blue', family: 'teal', hours: 'amber' };
const color = TOPIC_COLOR[feature.topic] ?? 'blue';
const classes = topicColorClasses(color);

const nation = await getNationStats();
const stateByPct = await getEntityRankings('state', feature.rankMetric);
const stateByCount = await getEntityRankings('state', feature.countMetric);
const availableVersions = await getAvailableVersions();

// Regions: rank by the same metric, but only among regions with enough
// facilities that a percentage/rate is meaningful. Listing counts come from a
// second ranking query and are joined in-memory (metrics are separate rows).
const regionByRank = await getEntityRankings('region', feature.rankMetric);
const regionFacilityCounts = await getEntityRankings('region', 'listing_count');
const regionFacilityLookup = Object.fromEntries(regionFacilityCounts.map((r) => [r.entity_id, r.value || 0]));

const MIN_LISTINGS_FOR_REGION_RANKING = 15;
const qualifyingRegions = regionByRank
  .filter((r) => (regionFacilityLookup[r.entity_id] || 0) >= MIN_LISTINGS_FOR_REGION_RANKING && r.value !== null)
  .map((r) => ({ ...r, listing_count: regionFacilityLookup[r.entity_id] || 0 }));

const topRegions = qualifyingRegions.slice().sort((a, b) => (b.value || 0) - (a.value || 0)).slice(0, 10);
const bottomRegions = qualifyingRegions.slice().sort((a, b) => (a.value || 0) - (b.value || 0)).slice(0, 10);

// Merge pct + count rankings per state for the table (two metric rows -> one row per state)
const countByState = Object.fromEntries(stateByCount.map((r) => [r.entity_id, r.value]));
const stateTable = stateByPct.map((r) => ({
  entity_id: r.entity_id,
  pct: r.value,
  count: countByState[r.entity_id] ?? null,
  rank: r.rank,
  rank_of: r.rank_of,
}));

const nationalAvgPct = stateByPct.length > 0
  ? stateByPct.reduce((sum, r) => sum + (r.value || 0), 0) / stateByPct.length
  : 0;

const pctValues = stateByPct.map((r) => r.value || 0).filter((v) => v > 0);
const pctMin = Math.min(...pctValues, 0);
const pctMax = Math.max(...pctValues, 100);

const bestState = stateByPct[0];
const worstState = stateByPct[stateByPct.length - 1];

const sourceVersion = nation?.listing_count?.source_version;
const year = (sourceVersion || '').split('-')[0] || ('' + new Date().getFullYear());

// Fall back to summing the state-level counts if the nation row for this
// metric is ever missing (defense-in-depth — generate-stats.js now always
// computes a nation total/average for every metric in the taxonomy, but a
// feature added without a matching nation push() would silently show 0).
const stateCountSum = stateByCount.reduce((sum, r) => sum + (r.value || 0), 0);
const nationCount = nation?.[feature.countMetric]?.value ?? stateCountSum;
const nationPct = nation?.[`${feature.pctMetric}_avg`]?.value ?? nationalAvgPct;
const nationPerCapita = feature.perCapitaMetric ? nation?.[feature.perCapitaMetric]?.value : null;

const title = `${feature.label} in Australia — State Rankings ${year} | Near Me Directory`;
const description = `${formatCount(nationCount)} ${feature.label.toLowerCase()} across Australia, ${formatPct(nationPct)} of all public listings. Full state and region breakdown for ${feature.audience.toLowerCase()}.`;
---

<Layout metadata={{ title, description, canonical: `https://facilitiesnearme.com.au/stats/features/${feature.slug}` }}>

  <!-- SECTION 1 — Hero, framed around the audience -->
  <section class={`py-12 bg-gradient-to-b ${classes.gradientFrom} to-white`}>
    
      <!-- Breadcrumbs -->
      <nav class="container mx-auto px-4 pb-4 text-sm text-gray-500" aria-label="Breadcrumb">
        <a href="/" class="hover:underline text-gray-600">Home</a>
        <span class="mx-1.5">/</span>
        <a href="/stats" class="hover:underline text-gray-600">Stats</a>
        <span class="mx-1.5">/</span>
        <span class="text-gray-700 font-medium">{feature.shortLabel}</span>
      </nav>

    <div class="container mx-auto px-4">
      <p class="text-sm font-semibold uppercase tracking-wide text-gray-500 mb-2">For {feature.audience}</p>
      <h1 class="text-3xl md:text-4xl font-bold text-gray-900 mb-3">{feature.label} in Australia</h1>
      <p class="text-gray-700 max-w-2xl mb-6">{feature.description}</p>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <StatTile
          value={formatCount(nationCount)}
          label={feature.shortLabel}
          sublabel="facilities nationally"
          topic={feature.topic}
        />
        <StatTile
          value={formatPct(nationPct)}
          label="of all listings"
          sublabel={bestState ? `up to ${formatPct(bestState.value)} in ${stateName(bestState.entity_id)}` : undefined}
          topic={feature.topic}
        />
        {feature.perCapitaMetric && nationPerCapita !== null && nationPerCapita !== undefined ? (
          <StatTile
            value={formatPerCapita(nationPerCapita, feature.perCapitaMetric.includes('100k') ? '100,000' : '10,000')}
            label="per capita"
            sublabel="national average"
            topic={feature.topic}
          />
        ) : (
          <StatTile
            value={formatRank(bestState?.rank, bestState?.rank_of)}
            label={stateName(bestState?.entity_id)}
            sublabel="leads the nation"
            topic={feature.topic}
          />
        )}
      </div>
    </div>
  </section>

  <!-- SECTION 2 — Why it matters, for this audience -->
  <section class="py-8 bg-white">
    <div class="container mx-auto px-4">
      <InsightCallout topic={feature.topic}>
        <p class="font-semibold mb-1">{feature.whyItMatters}</p>
        {bestState && worstState && (
          <p class="text-gray-700">
            Coverage ranges from {formatPct(bestState.value)} in {stateName(bestState.entity_id)} to {formatPct(worstState.value)} in {stateName(worstState.entity_id)} — where you are matters as much as the national average.
          </p>
        )}
      </InsightCallout>
    </div>
  </section>

  <!-- SECTION 3 — State rankings -->
  <section class="py-8 bg-gray-50">
    <div class="container mx-auto px-4">
      <h2 class="text-2xl font-bold text-gray-900 mb-2">{feature.shortLabel} by state</h2>
      <p class="text-gray-600 mb-4 text-sm">% of listings with {feature.shortLabel.toLowerCase()}, and total facility count</p>
      <div
        id="state-table"
        data-states={JSON.stringify(stateTable)}
        data-min={pctMin}
        data-max={pctMax}
        data-national-avg={nationalAvgPct}
        data-bar-class={classes.bar}
        data-link-class={classes.linkText}
        class="bg-white rounded-lg border border-gray-200"
      ></div>
    </div>
  </section>

  <!-- SECTION 4 — Regions -->
  {qualifyingRegions.length > 0 && (
    <section class="py-8 bg-white">
      <div class="container mx-auto px-4">
        <h2 class="text-2xl font-bold text-gray-900 mb-4">Best-covered regions</h2>
        <p class="text-gray-600 mb-3 text-sm">Minimum {MIN_LISTINGS_FOR_REGION_RANKING} facilities required to qualify.</p>
        <div id="top-regions" data-items={JSON.stringify(topRegions)} class="mb-8"></div>

        <h2 class="text-2xl font-bold text-gray-900 mb-4">Regions with the lowest coverage</h2>
        <div id="bottom-regions" data-items={JSON.stringify(bottomRegions)}></div>
      </div>
    </section>
  )}

  <!-- SECTION 5 — Find listings CTA -->
  <section class={`py-8 ${classes.bgLight}`}>
    <div class="container mx-auto px-4">
      <h2 class="text-xl font-bold text-gray-900 mb-2">Looking for a {feature.shortLabel.toLowerCase()} facility nearby?</h2>
      <a href={`/listings?feature=${feature.searchFilterKey}`} class={`inline-block text-sm font-medium ${classes.linkText} ${classes.linkTextHover}`}>
        Search {feature.shortLabel.toLowerCase()} listings near you &rarr;
      </a>
    </div>
  </section>

  <!-- Methodology -->
  <section class="py-8 bg-white">
    <div class="container mx-auto px-4">
      <h2 class="text-2xl font-bold text-gray-900 mb-4">About this data</h2>
      <p class="text-gray-700 mb-4">
        Data sourced from the National Public Listing Map, published by the Australian Department of Health.
      </p>
      <p class="text-gray-600 text-sm">Last updated: {formatVersion(sourceVersion)}</p>
    </div>
  </section>

  <!-- Year History -->
  <section class="py-8 bg-gray-50">
    <div class="container mx-auto px-4 text-center">
      <p class="text-xs text-gray-500 mb-2">Previous data releases:</p>
      <div class="flex justify-center gap-4 text-xs">
        {availableVersions.filter((v) => v !== sourceVersion).map((v) => (
          <a href={`?version=${v}`} class="text-gray-600 hover:underline">{formatVersion(v)}</a>
        ))}
      </div>
    </div>
  </section>
</Layout>

<script is:inline>
  function fmtCount(n) { return n ? Number(n).toLocaleString('en-AU') : '—'; }
  function fmtPct(n) { return (n || n === 0) ? Number(n).toFixed(1) + '%' : '—'; }
  function ordinalClient(n) {
    if (!n) return '—';
    const s = ['th', 'st', 'nd', 'rd'];
    const v = n % 100;
    return n + (s[(v - 20) % 10] || s[v] || s[0]);
  }
  const STATE_NAMES = { nsw: 'NSW', vic: 'VIC', qld: 'QLD', wa: 'WA', sa: 'SA', tas: 'TAS', act: 'ACT', nt: 'NT' };

  document.addEventListener('DOMContentLoaded', function () {
    const stateDiv = document.getElementById('state-table');
    if (stateDiv) {
      const states = JSON.parse(stateDiv.getAttribute('data-states') || '[]');
      const min = parseFloat(stateDiv.getAttribute('data-min') || '0');
      const max = parseFloat(stateDiv.getAttribute('data-max') || '100');
      const natAvg = parseFloat(stateDiv.getAttribute('data-national-avg') || '0');
      // Full class strings resolved server-side (see topicColorClasses in
      // lib/stats-utils) and passed through as-is — never rebuild a Tailwind
      // class name from a bare color string in client JS, since Tailwind's
      // JIT scanner can't see runtime-concatenated class names and will
      // purge them from the compiled CSS.
      const barClass = stateDiv.getAttribute('data-bar-class') || 'bg-blue-500';
      const linkClass = stateDiv.getAttribute('data-link-class') || 'text-blue-700';
      const range = (max || 100) - (min || 0);

      stateDiv.innerHTML = '<table class="w-full border-collapse">' +
        '<thead><tr class="border-b border-gray-200">' +
          '<th class="text-left py-2 px-3 text-sm font-semibold w-12">#</th>' +
          '<th class="text-left py-2 px-3 text-sm font-semibold">State</th>' +
          '<th class="text-left py-2 px-3 text-sm font-semibold">%</th>' +
          '<th class="text-right py-2 px-3 text-sm font-semibold">Facilities</th>' +
          '<th class="text-right py-2 px-3 text-sm font-semibold">Grade</th>' +
        '</tr></thead><tbody>' +
        states.map(function (s) {
          const pct = s.pct || 0;
          const barWidth = Math.max(5, ((pct - (min || 0)) / range) * 100);
          const grade = pct >= natAvg + 3 ? 'A' : pct >= natAvg - 3 ? 'B' : pct > 0 ? 'C' : '—';
          const gradeClass = grade === 'A' ? 'bg-green-100 text-green-800' : grade === 'B' ? 'bg-amber-100 text-amber-800' : grade === 'C' ? 'bg-red-100 text-red-800' : 'bg-gray-100 text-gray-800';
          return '<tr class="border-b border-gray-100">' +
            '<td class="py-2 px-3">' + ordinalClient(s.rank) + '</td>' +
            '<td class="py-2 px-3"><a href="/stats/' + s.entity_id + '" class="' + linkClass + ' hover:underline">' + (STATE_NAMES[s.entity_id] || s.entity_id.toUpperCase()) + '</a></td>' +
            '<td class="py-2 px-3"><div class="flex items-center gap-2"><div class="flex-1 bg-gray-200 rounded-full h-5 max-w-32 overflow-hidden"><div class="' + barClass + ' h-full" style="width: ' + barWidth + '%"></div></div><span class="text-sm font-semibold w-14">' + fmtPct(pct) + '</span></div></td>' +
            '<td class="py-2 px-3 text-right">' + fmtCount(s.count) + '</td>' +
            '<td class="py-2 px-3 text-right"><span class="text-xs px-2 py-1 rounded ' + gradeClass + '">' + grade + '</span></td>' +
          '</tr>';
        }).join('') + '</tbody></table>';
    }

    function renderRegionTable(id) {
      const div = document.getElementById(id);
      if (!div) return;
      const items = JSON.parse(div.getAttribute('data-items') || '[]');
      div.innerHTML = '<table class="w-full border-collapse">' +
        '<thead><tr class="border-b border-gray-200">' +
          '<th class="text-left py-2 px-3 text-sm font-semibold w-12">#</th>' +
          '<th class="text-left py-2 px-3 text-sm font-semibold">Region</th>' +
          '<th class="text-left py-2 px-3 text-sm font-semibold">State</th>' +
          '<th class="text-right py-2 px-3 text-sm font-semibold">Facilities</th>' +
          '<th class="text-right py-2 px-3 text-sm font-semibold">%</th>' +
        '</tr></thead><tbody>' +
        items.map(function (item, i) {
          return '<tr class="border-b border-gray-100">' +
            '<td class="py-2 px-3">' + (i + 1) + '</td>' +
            '<td class="py-2 px-3 font-medium">' + (item.metadata?.region_name || item.entity_id) + '</td>' +
            '<td class="py-2 px-3 text-sm">' + (item.metadata?.state_code || '').toUpperCase() + '</td>' +
            '<td class="py-2 px-3 text-right">' + fmtCount(item.listing_count) + '</td>' +
            '<td class="py-2 px-3 text-right font-semibold">' + fmtPct(item.value) + '</td>' +
          '</tr>';
        }).join('') + '</tbody></table>';
    }
    renderRegionTable('top-regions');
    renderRegionTable('bottom-regions');
  });
</script>
