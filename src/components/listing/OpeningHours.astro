---
// OpeningHours.astro - Formats the week-by-week layout with daylight hours and season labels

export interface FormattedSlot {
  open: string;
  close: string;
  is24Hours: boolean;
  isDaylight: boolean;
  isUnknown: boolean;
  seasonLabel?: string;
}

export interface FormattedDay {
  day: number;
  label: string;
  slots: FormattedSlot[];
}

export interface Props {
  formattedHours: FormattedDay[];
  openingHoursNote?: string;
}

const { formattedHours, openingHoursNote } = Astro.props;
---

{(!formattedHours || formattedHours.length === 0) ? (
  <div class="w-full">
    <h2 class="text-sm font-semibold text-gray-500 uppercase tracking-wider mb-2">Opening Hours</h2>
    <p class="text-sm text-gray-400 italic">Opening hours not available.</p>
  </div>
) : (
  <div class="w-full">
    <h2 class="text-sm font-semibold text-gray-500 uppercase tracking-wider mb-2">Opening Hours</h2>
    <div class="rounded-xl border border-gray-200 overflow-hidden">
      {formattedHours.map(({ label, slots }) => (
        <div class="flex items-start justify-between gap-4 px-4 py-2.5 text-sm bg-white" key={label}>
          <span class="w-16 shrink-0 font-medium text-gray-900">{label}</span>
          <div class="flex flex-col items-end gap-0.5">
            {slots.map((slot, idx) => (
              <div key={idx} class="flex items-baseline gap-1.5">
                <span class="text-gray-700">
                  {slot.is24Hours ? 'Open 24 hours' : slot.isUnknown ? 'Hours unknown' : slot.open + ' -- ' + slot.close}
                </span>
                {slot.isDaylight && <span class="text-xs text-amber-600 font-medium">daylight</span>}
                {slot.seasonLabel && <span class="text-xs text-gray-400">({slot.seasonLabel})</span>}
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
    {openingHoursNote && (
      <p class="mt-2 text-sm text-gray-600 italic">{openingHoursNote}</p>
    )}
  </div>
)}