---
// FeatureList.astro - Renders the grid of functional amenities with appropriate SVG icons
// Icons migrated to Lucide (2026-06-17)

import Icon from '../ui/Icon.astro';

export interface Props {
  features: Array<{ listing_id: string; feature_key: string }> | null;
}

const { features } = Astro.props;

if (!features || features.length === 0) {
  return null;
}

// Feature icon mapping - maps facility feature keys to Lucide icon names
const FEATURE_ICON_MAP: Record<string, string> = {
  accessible: 'accessibility',
  adult_change: 'accessibility',
  all_gender: 'users',
  ambulant: 'accessibility',
  baby_care_room: 'baby',
  baby_change: 'baby',
  changing_places: 'accessibility',
  drinking_water: 'glassWater',
  dump_point: 'trash2',
  female: 'venus',
  key_required: 'key',
  lh_transfer: 'accessibility',
  male: 'mars',
  mens_pad_disposal: 'trash2',
  mlak: 'key',
  parking: 'squareParking',
  parking_accessible: 'squareParking',
  payment_required: 'creditCard',
  rh_transfer: 'accessibility',
  sanitary_disposal: 'trash2',
  sharps_disposal: 'syringe',
  shower: 'showerHead',
  unisex: 'users',
};

// Feature labels
const FEATURE_LABELS: Record<string, string> = {
  accessible: 'Accessible',
  adult_change: 'Adult change',
  all_gender: 'All gender',
  ambulant: 'Ambulant',
  baby_care_room: 'Baby care room',
  baby_change: 'Baby change',
  changing_places: 'Changing places',
  drinking_water: 'Drinking water',
  dump_point: 'Dump point',
  female: 'Female',
  key_required: 'Key required',
  lh_transfer: 'LH transfer',
  male: 'Male',
  mens_pad_disposal: 'Male disposal',
  mlak: 'MLAK',
  parking: 'Parking',
  parking_accessible: 'Accessible parking',
  payment_required: 'Payment required',
  rh_transfer: 'RH transfer',
  sanitary_disposal: 'Sanitary disposal',
  sharps_disposal: 'Sharps disposal',
  shower: 'Shower',
  unisex: 'Unisex',
};

// High-priority features (highlighted with blue background)
const HIGH_PRIORITY_FEATURES = ['accessible', 'baby_change', 'parking'];

// Get icon for a feature key (fallback to info if not found)
const getFeatureIcon = (key: string): string => FEATURE_ICON_MAP[key] || 'info';

// Get label for a feature key (fallback to formatted key)
const getFeatureLabel = (key: string): string => FEATURE_LABELS[key] || key.replace(/_/g, ' ');
---

<div class="w-full">
  <h2 class="text-sm font-semibold text-gray-500 uppercase tracking-wider mb-2">Facilities</h2>
  <ul class="grid grid-cols-2 gap-2">
    {features.map((feature) => {
      const isPriority = HIGH_PRIORITY_FEATURES.includes(feature.feature_key);
      const iconName = getFeatureIcon(feature.feature_key);
      const label = getFeatureLabel(feature.feature_key);
      const itemClass = isPriority
        ? 'flex items-center gap-2.5 px-3 py-2.5 rounded-xl border text-sm bg-blue-50 border-blue-200 text-blue-900'
        : 'flex items-center gap-2.5 px-3 py-2.5 rounded-xl border text-sm bg-gray-50 border-gray-200 text-gray-700';
      
      return (
        <li key={feature.feature_key} class={itemClass}>
          <Icon name={iconName} class="w-3.5 h-3.5 shrink-0" />
          <span class={isPriority ? 'font-semibold' : ''}>{label}</span>
        </li>
      );
    })}
  </ul>
</div>