---
// SuburbListingList.astro - List of listings in a suburb
// Matches Next.js sidebar styling with Directions/View buttons
// Icons migrated to Lucide (2026-06-16)
import { getDirectionsUrl } from '../../lib/geo';
import Icon from '../ui/Icon.astro';

interface FacilityItem {
  listing_id: string;
  slug: string;
  name: string;
  address?: string;
  latitude?: number;
  longitude?: number;
  is_open_24h?: boolean;
  region_slug?: string;
  suburb_slug?: string;
}

interface Props {
  listings: FacilityItem[];
  stateSlug: string;
  suburbName?: string;
}

const { listings, stateSlug, suburbName } = Astro.props;
---

<div class="w-full">
  <h2 class="text-base font-bold text-gray-900 mb-3">
    All listings in {suburbName || 'this area'}
  </h2>
  <ul class="flex flex-col gap-3">
    {listings.map(facility => {
      const regionSlug = facility.region_slug || '';
      const suburbSlug = facility.suburb_slug || '';
      const href = regionSlug && suburbSlug
        ? `/${stateSlug}/${regionSlug}/${suburbSlug}/${facility.slug}`
        : null;
      const directionsUrl = getDirectionsUrl(facility.latitude, facility.longitude, facility.name);
      
      return (
        <li class="rounded-xl border border-gray-200 overflow-hidden hover:border-blue-300 transition-colors">
          <div class="px-4 py-4">
            {href ? (
              <a href={href} class="block text-[15px] font-bold text-gray-900 hover:text-blue-700 leading-snug mb-1 transition-colors">
                {facility.name}
              </a>
            ) : (
              <p class="text-[15px] font-bold text-gray-900 leading-snug mb-1">{facility.name}</p>
            )}
            {facility.address && (
              <p class="text-sm text-gray-500 mb-3">{facility.address}</p>
            )}
            {facility.is_open_24h && (
              <span class="inline-block text-xs font-semibold text-green-700 bg-green-50 border border-green-200 rounded-full px-2.5 py-0.5 mb-3">
                Open 24 hrs
              </span>
            )}
            <div class="flex gap-2">
              <a href={directionsUrl} target="_blank" rel="noopener noreferrer"
                 class="flex-1 flex items-center justify-center gap-1.5 h-10 bg-blue-600 hover:bg-blue-700 text-white text-sm font-semibold rounded-xl transition-colors">
                <Icon name="send" size={13} strokeWidth={2} />
                Get Directions
              </a>
              {href && (
                <a href={href} class="flex items-center justify-center h-10 px-4 text-sm font-semibold text-gray-700 bg-white border border-gray-200 hover:bg-gray-50 rounded-xl transition-colors">
                  View details
                </a>
              )}
            </div>
          </div>
        </li>
      );
    })}
  </ul>
</div>