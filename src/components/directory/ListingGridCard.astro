---
// ListingGridCard.astro - Condensed facility card for grid layouts
// Shows: name, address, feature badge, and action buttons in a compact form
// Optimized for 3-column grid display on feature-filter pages
import Icon from '../ui/Icon.astro';

interface Props {
  listing: {
    listing_id: string;
    slug: string;
    name: string;
    address?: string;
    latitude?: number;
    longitude?: number;
    is_open_24h?: boolean;
    region_slug?: string;
    suburb_slug?: string;
    state_code?: string;
  };
  featureKey: string;
}

const { facility, featureKey } = Astro.props;

// Build detail URL
const stateSlug = (facility.state_code || 'nsw').toLowerCase();
const detailHref = facility.region_slug && facility.suburb_slug
  ? `/${stateSlug}/${facility.region_slug}/${facility.suburb_slug}/${facility.slug}`
  : null;

// Build Google directions URL
const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(facility.name)}`;

// Feature badge styles
const FEATURE_STYLES: Record<string, { label: string; color: string }> = {
  accessible: { label: 'Accessible', color: 'text-indigo-700 bg-indigo-50 border-indigo-200' },
  baby_change: { label: 'Baby change', color: 'text-purple-700 bg-purple-50 border-purple-200' },
  drinking_water: { label: 'Water', color: 'text-blue-700 bg-blue-50 border-blue-200' },
  parking: { label: 'Parking', color: 'text-gray-700 bg-gray-50 border-gray-200' },
  sharps_disposal: { label: 'Sharps', color: 'text-orange-700 bg-orange-50 border-orange-200' },
  sanitary_disposal: { label: 'Sanitary', color: 'text-orange-700 bg-orange-50 border-orange-200' },
  shower: { label: 'Shower', color: 'text-teal-700 bg-teal-50 border-teal-200' },
  unisex: { label: 'Unisex', color: 'text-pink-700 bg-pink-50 border-pink-200' },
  all_gender: { label: 'All gender', color: 'text-pink-700 bg-pink-50 border-pink-200' },
};
---
<li class="rounded-xl border border-gray-200 bg-white hover:border-blue-300 hover:shadow-sm transition-all">
  <div class="p-4 flex flex-col h-full">
    <!-- Feature badge -->
    {FEATURE_STYLES[featureKey] && (
      <span class={`inline-flex items-center text-xs font-semibold border rounded-full px-2.5 py-0.5 mb-2 self-start ${FEATURE_STYLES[featureKey].color}`}>
        {FEATURE_STYLES[featureKey].label}
      </span>
    )}

    <!-- Name -->
    {detailHref ? (
      <a href={detailHref} class="block text-sm font-bold text-gray-900 hover:text-blue-700 leading-snug mb-1 transition-colors">
        {facility.name}
      </a>
    ) : (
      <p class="text-sm font-bold text-gray-900 leading-snug mb-1">{facility.name}</p>
    )}

    <!-- Address -->
    {facility.address && (
      <p class="text-xs text-gray-500 mb-3 line-clamp-2 flex-1">
        {facility.address}
      </p>
    )}

    <!-- 24hr indicator -->
    {facility.is_open_24h && (
      <span class="inline-block text-xs font-semibold text-green-700 bg-green-50 border border-green-200 rounded-full px-2.5 py-0.5 mb-3 self-start">
        Open 24 hrs
      </span>
    )}

    <!-- Action buttons -->
    <div class="flex gap-2 mt-auto">
      <a href={directionsUrl} target="_blank" rel="noopener noreferrer"
         class="flex-1 flex items-center justify-center gap-1 h-8 text-xs font-semibold text-blue-700 bg-blue-50 hover:bg-blue-100 rounded-lg transition-colors">
        <Icon name="send" size={11} strokeWidth={2} />
        Directions
      </a>
      {detailHref && (
        <a href={detailHref} class="flex items-center justify-center h-8 px-3 text-xs font-semibold text-gray-700 bg-white border border-gray-200 hover:bg-gray-50 rounded-lg transition-colors">
          Details
        </a>
      )}
    </div>
  </div>
</li>