---
// ListingCard.astro - Individual facility display in list
// Shows: name, distance, address, open status, features, action buttons
// Icons migrated to Lucide (2026-06-15)

import Icon from '../ui/Icon.astro';

interface Props {
  listing: {
    listing_id: string;
    name: string;
    latitude: number;
    longitude: number;
    slug: string;
    state_code?: string;
    region_slug?: string;
    suburb_slug?: string;
    address?: string;
    is_open_24h: boolean;
  };
  distanceM?: number;
  isBestOption?: boolean;
  features?: string[];
  openStatus?: { isOpen: boolean; label: string } | null;
}

const { facility, distanceM, isBestOption = false, features = [], openStatus } = Astro.props;

// Build detail URL
const stateSlug = (facility.state_code || 'nsw').toLowerCase();
const detailHref = facility.region_slug && facility.suburb_slug
  ? `/${stateSlug}/${facility.region_slug}/${facility.suburb_slug}/${facility.slug}`
  : null;

// Build Google directions URL
const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(facility.name)}`;

// Format distance
const formatDistance = (m: number) => m < 1000 ? `${Math.round(m)}m` : `${(m / 1000).toFixed(1)}km`;

// Active feature pills
const FEATURE_PILLS = [
  { key: 'accessible', label: 'Accessible', color: 'text-indigo-700 bg-indigo-50 border-indigo-200' },
  { key: 'baby_change', label: 'Baby change', color: 'text-purple-700 bg-purple-50 border-purple-200' },
  { key: 'drinking_water', label: 'Water', color: 'text-blue-700 bg-blue-50 border-blue-200' },
  { key: 'shower', label: 'Shower', color: 'text-teal-700 bg-teal-50 border-teal-200' },
  { key: 'parking', label: 'Parking', color: 'text-gray-700 bg-gray-50 border-gray-200' },
];

const activePills = FEATURE_PILLS.filter(p => features.includes(p.key));
const hasPills = openStatus || activePills.length > 0;
---

<div class={`facility-card-item relative px-4 py-4 bg-white hover:bg-gray-50/80 transition-colors ${isBestOption ? 'border-l-[3px] border-l-amber-400' : 'border-l-[3px] border-l-transparent border-b border-gray-100'}`}>
  <!-- Name + distance -->
  <div class="flex items-start justify-between gap-3 mb-1">
    {detailHref ? (
      <a href={detailHref} class="flex-1 text-[15px] font-bold text-gray-900 hover:text-blue-700 leading-snug transition-colors">
        {facility.name}
      </a>
    ) : (
      <span class="flex-1 text-[15px] font-bold text-gray-900 leading-snug">{facility.name}</span>
    )}
    {distanceM !== undefined && (
      <span class="shrink-0 mt-0.5 text-xs font-semibold text-gray-500 bg-gray-100 rounded-full px-2.5 py-1">
        {formatDistance(distanceM)}
      </span>
    )}
  </div>

  <!-- Address -->
  {facility.address && (
    <p class="flex items-center gap-1.5 text-xs text-gray-500 mb-2.5">
      <Icon name="mapPin" size={11} strokeWidth={2} class="shrink-0 text-gray-400" />
      {facility.address}
    </p>
  )}

  <!-- Open status pill + feature pills -->
  {hasPills && (
    <div class="flex flex-wrap items-center gap-1.5 mb-3">
      <!-- Open status first -->
      {openStatus && (
        openStatus.isOpen ? (
          <span class="inline-flex items-center text-xs font-semibold text-green-700 bg-green-50 border border-green-200 rounded-full px-2.5 py-1">
            {openStatus.label || 'Open'}
          </span>
        ) : openStatus.label === 'Hours unknown' ? (
          <span class="inline-flex items-center text-xs font-semibold text-gray-700 bg-gray-50 border border-gray-200 rounded-full px-2.5 py-1">
            Hours unknown
          </span>
        ) : openStatus.label ? (
          <span class="inline-flex items-center text-xs font-semibold text-red-700 bg-red-50 border border-red-200 rounded-full px-2.5 py-1">
            {openStatus.label}
          </span>
        ) : null
      )}


      <!-- Feature pills -->
      {activePills.map(pill => (
        <span key={pill.key} class={`inline-flex items-center gap-1 text-xs font-medium border rounded-full px-2.5 py-1 ${pill.color}`}>
          {pill.label}
        </span>
      ))}
    </div>
  )}

  <!-- Action buttons -->
  <div class="flex gap-2">
    <a
      href={directionsUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="flex-1 flex items-center justify-center gap-1.5 h-10 bg-blue-600 hover:bg-blue-700 text-white text-sm font-semibold rounded-xl shadow-sm shadow-blue-200 transition-colors"
    >
      <Icon name="send" size={13} strokeWidth={2} />
      Get Directions
    </a>
    {detailHref && (
      <a
        href={detailHref}
        class="flex items-center justify-center h-10 px-4 text-sm font-semibold text-gray-700 bg-white border border-gray-200 hover:bg-gray-50 rounded-xl shadow-sm transition-colors"
      >
        View details
      </a>
    )}
  </div>
</div>