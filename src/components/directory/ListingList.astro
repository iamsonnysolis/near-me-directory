---
// ListingList.astro - Sidebar/mobile list for homepage map
// Shows "Best option near you" banner, count header, and ListingCard items
// Supports both SSR rendering and client-side updates via facilitiesUpdated events
import ListingCard from './ListingCard.astro';
import SkeletonListingCard from './SkeletonListingCard.astro';

interface Listing {
  listing_id: string;
  name: string;
  latitude: number;
  longitude: number;
  slug: string;
  state_code?: string;
  region_slug?: string;
  suburb_slug?: string;
  address?: string;
  is_open_24h: boolean;
}

interface Props {
  listings?: Listing[];
  features?: Record<string, string[]>;
  openStatus?: Record<string, { isOpen: boolean; label: string }>;
  loading?: boolean;
  error?: string | null;
  userLat?: number;
  userLng?: number;
  geoStatus?: string;
}

// Default values for SSR
const { 
  listings = [], 
  features = {}, 
  openStatus = {}, 
  loading = false, 
  error = null,
  userLat,
  userLng,
  geoStatus = 'idle'
} = Astro.props;

// Distance calculation (Haversine) - used for sorting
function distM(lat1: number, lng1: number, lat2: number, lng2: number): number {
  const R = 6371000;
  const ph1 = (lat1 * Math.PI) / 180;
  const ph2 = (lat2 * Math.PI) / 180;
  const ph = ((lat2 - lat1) * Math.PI) / 180;
  const λ = ((lng2 - lng1) * Math.PI) / 180;
  const a = Math.sin(ph / 2) ** 2 + Math.cos(ph1) * Math.cos(ph2) * Math.sin(λ / 2) ** 2;
  return R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
}

// Format distance
const formatDistance = (m: number) => m < 1000 ? `${Math.round(m)}m` : `${(m / 1000).toFixed(1)}km`;

// Sort listings by distance
const hasUserLoc = userLat !== undefined && userLng !== undefined;
const sorted = hasUserLoc 
  ? [...listings].sort((a, b) => distM(userLat, userLng, a.latitude, a.longitude) - distM(userLat, userLng, b.latitude, b.longitude))
  : listings;

// Find best option
let bestFacility: Listing | null = null;
let restFacilities: Listing[] = [];

if (sorted.length > 0) {
  const hasStatusData = Object.keys(openStatus).length > 0;
  if (hasStatusData) {
    const closestOpen = sorted.find((t) => openStatus[t.listing_id]?.isOpen === true);
    bestFacility = closestOpen ?? sorted[0] ?? null;
  } else {
    bestFacility = sorted[0] ?? null;
  }
  restFacilities = bestFacility
    ? sorted.filter((t) => t.listing_id !== bestFacility!.listing_id)
    : sorted;
}
---

<div data-facility-list data-loading={loading} class="flex flex-col h-full">
  <!-- Error state -->
  {error && (
    <div class="flex flex-col items-center justify-center gap-3 px-6 py-12 text-center">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-red-400">
        <circle cx="12" cy="12" r="10"></circle>
        <line x1="12" y1="8" x2="12" y2="12"></line>
        <line x1="12" x2="12" y1="16" y2="16"></line>
      </svg>
      <p class="text-sm font-semibold text-gray-800">{error}</p>
    </div>
  )}

  <!-- Empty state -->
  {!loading && !error && listings.length === 0 && geoStatus === 'idle' && (
    <div class="flex flex-col items-center justify-center gap-3 px-6 py-12 text-center">
      <span class="text-3xl">🚽</span>
      <p class="text-sm font-bold text-gray-800">No listings found here</p>
      <p class="text-xs text-gray-500 max-w-[180px]">Try zooming out or removing filters.</p>
    </div>
  )}

  <!-- Loading skeleton - shown when loading=true and no listings yet -->
  {loading && listings.length === 0 && (
    <div class="flex flex-col">
      <div class="h-10 border-b border-gray-100 flex items-center px-4">
        <div class="h-3 w-20 bg-gray-200 rounded animate-pulse"></div>
      </div>
      <SkeletonListingCard />
      <SkeletonListingCard />
      <SkeletonListingCard />
      <SkeletonListingCard />
    </div>
  )}

  <!-- Results -->
  {!error && listings.length > 0 && (
    <>
      {/* Count header */}
      <div class="flex items-center justify-between px-4 py-3 border-b border-gray-100 sticky top-0 bg-white z-10">
        <p class="text-sm text-gray-700">
          <span class="font-bold text-gray-900">{listings.length}</span>
          facility{listings.length !== 1 ? 's' : ''}
          {loading && <span class="ml-2 text-xs text-amber-500">updating...</span>}
        </p>
        {hasUserLoc && (
          <span class="text-[10px] font-bold tracking-widest text-gray-400 uppercase">By distance</span>
        )}
      </div>

      <!-- Best option card -->
      {bestFacility && (
        <div class="bg-blue-600 px-3 pb-3 pt-2.5">
          <p class="text-[11px] font-black tracking-widest text-white/70 uppercase flex items-center gap-1.5 mb-2">
            <span class="text-amber-400 text-sm">★</span> Best option near you
          </p>
          <div class="rounded-2xl overflow-hidden bg-white shadow-md">
            <ListingCard 
              facility={bestFacility}
              distanceM={hasUserLoc ? distM(userLat!, userLng!, bestFacility.latitude, bestFacility.longitude) : undefined}
              features={features[bestFacility.listing_id] ?? []}
              openStatus={openStatus[bestFacility.listing_id] ?? null}
              isBestOption={true}
            />
          </div>
        </div>
      )}

      <!-- Remaining listings -->
      {restFacilities.map((facility) => (
        <ListingCard 
          key={facility.listing_id}
          facility={facility}
          distanceM={hasUserLoc ? distM(userLat!, userLng!, facility.latitude, facility.longitude) : undefined}
          features={features[facility.listing_id] ?? []}
          openStatus={openStatus[facility.listing_id] ?? null}
        />
      ))}
    </>
  )}
</div>

<script is:inline>
// Client-side handler for facilitiesUpdated events
// Populates the ListingList component with dynamic data from the map

(function() {
  // Feature icon SVG strings (from feature-icon-svgs.ts - derived from Lucide icon nodes)
  const FEATURE_ICONS = {
    accessible: '<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="16" cy="4" r="1"></circle><path d="m18 19 1-7-6 1"></path><path d="m5 8 3-3 5.5 3-2.36 3.5"></path><path d="M4.24 14.5a5 5 0 0 0 6.88 6"></path><path d="M13.76 17.5a5 5 0 0 0-6.88-6"></path></svg>',
    baby_change: '<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 16c.5.3 1.2.5 2 .5s1.5-.2 2-.5"></path><path d="M15 12h.01"></path><path d="M19.38 6.813A9 9 0 0 1 20.8 10.2a2 2 0 0 1 0 3.6 9 9 0 0 1-17.6 0 2 2 0 0 1 0-3.6A9 9 0 0 1 12 3c2 0 3.5 1.1 3.5 2.5s-.9 2.5-2 2.5c-.8 0-1.5-.4-1.5-1"></path><path d="M9 12h.01"></path></svg>',
    drinking_water: '<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5.116 4.104A1 1 0 0 1 6.11 3h11.78a1 1 0 0 1 .994 1.105L17.19 20.21A2 2 0 0 1 15.2 22H8.8a2 2 0 0 1-2-1.79z"></path><path d="M6 12a5 5 0 0 1 6 0 5 5 0 0 0 6 0"></path></svg>',
    parking: '<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2"></rect><path d="M9 17V7h4a3 3 0 0 1 0 6H9"></path></svg>',
    sharps_disposal: '<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m18 2 4 4"></path><path d="m17 7 3-3"></path><path d="M19 9 8.7 19.3c-1 1-2.5 1-3.4 0l-.6-.6c-1-1-1-2.5 0-3.4L15 5"></path><path d="m9 11 4 4"></path><path d="m5 19-3 3"></path><path d="m14 4 6 6"></path></svg>',
    sanitary_disposal: '<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 11v6"></path><path d="M14 11v6"></path><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"></path><path d="M3 6h18"></path><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>',
    shower: '<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m4 4 2.5 2.5"></path><path d="M13.5 6.5a4.95 4.95 0 0 0-7 7"></path><path d="M15 5 5 15"></path><path d="M14 17v.01"></path><path d="M10 16v.01"></path><path d="M13 13v.01"></path><path d="M16 10v.01"></path><path d="M11 20v.01"></path><path d="M17 14v.01"></path><path d="M20 11v.01"></path></svg>',
    unisex: '<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><path d="M16 3.128a4 4 0 0 1 0 7.744"></path><path d="M22 21v-2a4 4 0 0 0-3-3.87"></path><circle cx="9" cy="7" r="4"></circle></svg>',
    all_gender: '<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><path d="M16 3.128a4 4 0 0 1 0 7.744"></path><path d="M22 21v-2a4 4 0 0 0-3-3.87"></path><circle cx="9" cy="7" r="4"></circle></svg>',
    female: '<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 15v7"></path><path d="M9 19h6"></path><circle cx="12" cy="9" r="6"></circle></svg>',
    male: '<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 3h5v5"></path><path d="m21 3-6.75 6.75"></path><circle cx="10" cy="14" r="6"></circle></svg>',
  };

  // Feature labels (capitalized)
  const FEATURE_LABELS = {
    accessible: 'Accessible',
    baby_change: 'Baby change',
    drinking_water: 'Water',
    parking: 'Parking',
    sharps_disposal: 'Sharps disposal',
    sanitary_disposal: 'Sanitary disposal',
    shower: 'Shower',
    unisex: 'Unisex',
    all_gender: 'All gender',
    female: 'Female',
    male: 'Male',
  };

  // Feature pill Tailwind styles
  const FEATURE_PILLS = {
    accessible: 'text-indigo-700 bg-indigo-50 border-indigo-200',
    baby_change: 'text-purple-700 bg-purple-50 border-purple-200',
    drinking_water: 'text-blue-700 bg-blue-50 border-blue-200',
    parking: 'text-gray-700 bg-gray-50 border-gray-200',
    sharps_disposal: 'text-orange-700 bg-orange-50 border-orange-200',
    sanitary_disposal: 'text-orange-700 bg-orange-50 border-orange-200',
    shower: 'text-teal-700 bg-teal-50 border-teal-200',
    unisex: 'text-pink-700 bg-pink-50 border-pink-200',
    all_gender: 'text-pink-700 bg-pink-50 border-pink-200',
    female: 'text-pink-700 bg-pink-50 border-pink-200',
    male: 'text-blue-700 bg-blue-50 border-blue-200',
  };

  function distM(lat1, lng1, lat2, lng2) {
    const R = 6371000;
    const ph1 = (lat1 * Math.PI) / 180;
    const ph2 = (lat2 * Math.PI) / 180;
    const ph = ((lat2 - lat1) * Math.PI) / 180;
    const λ = ((lng2 - lng1) * Math.PI) / 180;
    const a = Math.sin(ph / 2) ** 2 + Math.cos(ph1) * Math.cos(ph2) * Math.sin(λ / 2) ** 2;
    return R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
  }

  function formatDistance(m) {
    return m < 1000 ? Math.round(m) + 'm' : (m / 1000).toFixed(1) + 'km';
  }

  function renderListingCard(facility, distanceM, features, openStatus, isBestOption) {
    const stateSlug = (facility.state_code || 'nsw').toLowerCase();
    const href = facility.region_slug && facility.suburb_slug
      ? '/' + stateSlug + '/' + facility.region_slug + '/' + facility.suburb_slug + '/' + facility.slug
      : null;
    const directionsUrl = 'https://www.google.com/maps/dir/?api=1&destination=' + encodeURIComponent(facility.name);

    const borderClass = isBestOption ? 'border-l-[3px] border-l-amber-400' : 'border-l-[3px] border-l-transparent border-b border-gray-100';

    let pillsHtml = '';
    if (openStatus && openStatus.isOpen) {
      pillsHtml += '<span class="inline-flex items-center text-xs font-semibold text-green-700 bg-green-50 border border-green-200 rounded-full px-2.5 py-1">' + (openStatus.label || 'Open') + '</span>';
    } else if (openStatus && openStatus.label) {
      const closedStyle = openStatus.label === 'Hours unknown' ? 'text-gray-700 bg-gray-50 border-gray-200' : 'text-red-700 bg-red-50 border-red-200';
      pillsHtml += '<span class="inline-flex items-center text-xs font-semibold ' + closedStyle + ' rounded-full px-2.5 py-1">' + openStatus.label + '</span>';
    }


    const featurePills = (features || []);
    featurePills.forEach(key => {
      const color = FEATURE_PILLS[key];
      const icon = FEATURE_ICONS[key] || '';
      const label = FEATURE_LABELS[key] || key.replace(/_/g, ' ');
      if (color) {
        pillsHtml += '<span class="inline-flex items-center gap-1 text-xs font-medium border rounded-full px-2.5 py-1 ' + color + '">' + icon + '<span class="ml-0.5">' + label + '</span></span>';
      }
    });

    const distanceBadge = distanceM !== null && distanceM !== undefined
      ? '<span class="shrink-0 mt-0.5 text-xs font-semibold text-gray-500 bg-gray-100 rounded-full px-2.5 py-1">' + formatDistance(distanceM) + '</span>'
      : '';

    const addressHtml = facility.address 
      ? '<p class="flex items-center gap-1.5 text-xs text-gray-500 mb-2.5"><svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 text-gray-400"><path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"></path><circle cx="12" cy="10" r="3"></circle></svg>' + facility.address + '</p>'
      : '';

    const pillsWrapper = pillsHtml ? '<div class="flex flex-wrap items-center gap-1.5 mb-3">' + pillsHtml + '</div>' : '';

    const nameHtml = href 
      ? '<a href="' + href + '" class="flex-1 text-[15px] font-bold text-gray-900 hover:text-blue-700 leading-snug transition-colors">' + facility.name + '</a>'
      : '<span class="flex-1 text-[15px] font-bold text-gray-900 leading-snug">' + facility.name + '</span>';

    const detailsBtn = href 
      ? '<a href="' + href + '" class="flex items-center justify-center h-10 px-4 text-sm font-semibold text-gray-700 bg-white border border-gray-200 hover:bg-gray-50 rounded-xl shadow-sm transition-colors">View details</a>'
      : '';

    return '<div class="' + borderClass + ' relative px-4 py-4 bg-white hover:bg-gray-50/80 transition-colors">' +
      '<div class="flex items-start justify-between gap-3 mb-1">' + nameHtml + distanceBadge + '</div>' +
      addressHtml + pillsWrapper +
      '<div class="flex gap-2">' +
        '<a href="' + directionsUrl + '" target="_blank" rel="noopener noreferrer" class="flex-1 flex items-center justify-center gap-1.5 h-10 bg-blue-600 hover:bg-blue-700 text-white text-sm font-semibold rounded-xl shadow-sm shadow-blue-200 transition-colors">' +
          '<svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.536 21.686a.5.5 0 0 0 .937-.024l6.5-19a.496.496 0 0 0-.635-.635l-19 6.5a.5.5 0 0 0-.024.937l7.93 3.18a2 2 0 0 1 1.112 1.11z"></path><path d="m21.854 2.147-10.94 10.939"></path></svg>Get Directions</a>' +
        detailsBtn +
      '</div></div>';
  }

  // Find best facility when data arrives
  function findBestFacility(listings, openStatus) {
    if (!listings || listings.length === 0) return { best: null, rest: [] };
    const hasStatusData = openStatus && Object.keys(openStatus).length > 0;
    let best = null;
    if (hasStatusData) {
      best = listings.find(t => openStatus[t.listing_id]?.isOpen === true);
      best = best || listings[0];
    } else {
      best = listings[0];
    }
    return {
      best: best,
      rest: listings.filter(t => t.listing_id !== best.listing_id)
    };
  }

  // Show loading skeleton in all facility lists
  function showLoadingSkeleton() {
    document.querySelectorAll('[data-facility-list]').forEach(list => {
      // Only show skeleton if list is empty
      const currentHtml = list.innerHTML;
      if (currentHtml.includes('No listings found') || currentHtml.includes('flex flex-col h-full') && currentHtml.trim() === '') {
        list.innerHTML = '<div class="flex flex-col"><div class="h-10 border-b border-gray-100 flex items-center px-4"><div class="h-3 w-20 bg-gray-200 rounded animate-pulse"></div></div>' + 
          Array.from({ length: 4 }).map(() => '<div class="px-4 py-4 border-b border-gray-100"><div class="animate-pulse"><div class="h-4 bg-gray-200 rounded w-3/4 mb-2"></div><div class="h-3 bg-gray-200 rounded w-1/2 mb-3"></div><div class="h-8 bg-gray-200 rounded"></div></div></div>').join('') + '</div>';
      }
    });
  }

  // Update all facility lists on page
  function updateListingLists(e) {
    const { listings, features, openStatus, userLocation } = e.detail;
    const userLat = userLocation?.lat;
    const userLng = userLocation?.lng;

    document.querySelectorAll('[data-facility-list]').forEach(list => {
      // Fade out, then update
      list.classList.add('transition-opacity', 'duration-200', 'opacity-0');
      setTimeout(() => {
        list.innerHTML = '';

        const hasUserLoc = userLat !== undefined && userLng !== undefined;

        // Sort by distance
        const sorted = (hasUserLoc && listings.length > 0)
          ? [...listings].sort((a, b) => distM(userLat, userLng, a.latitude, a.longitude) - distM(userLat, userLng, b.latitude, b.longitude))
          : listings;

        const { best, rest } = findBestFacility(sorted, openStatus || {});

        // Empty state
        if (listings.length === 0) {
          list.innerHTML = '<div class="flex flex-col items-center justify-center gap-3 px-6 py-12 text-center"><span class="text-3xl">🚽</span><p class="text-sm font-bold text-gray-800">No listings found here</p><p class="text-xs text-gray-500 max-w-[180px]">Try zooming out or removing filters.</p></div>';
          list.classList.remove('opacity-0');
          return;
        }

        // Count header
        const countHeader = '<div class="flex items-center justify-between px-4 py-3 h-10 border-b border-gray-100 sticky top-0 bg-white z-10"><p class="text-sm text-gray-700"><span class="font-bold text-gray-900">' + listings.length + '</span> facility' + (listings.length !== 1 ? 's' : '') + '</p>' + (hasUserLoc ? '<span class="text-[10px] font-bold tracking-widest text-gray-400 uppercase">By distance</span>' : '') + '</div>';

        // Best option section
        let html = countHeader;
        if (best) {
          html += '<div class="bg-blue-600 px-3 pb-3 pt-2.5"><p class="text-[11px] font-black tracking-widest text-white/70 uppercase flex items-center gap-1.5 mb-2"><span class="text-amber-400 text-sm">★</span> Best option near you</p><div class="rounded-2xl overflow-hidden bg-white shadow-md">' + 
            renderListingCard(best, hasUserLoc ? distM(userLat, userLng, best.latitude, best.longitude) : null, features?.[best.listing_id], openStatus?.[best.listing_id], true) + '</div></div>';
        }

        // Rest of listings
        rest.forEach(facility => {
          html += renderListingCard(facility, hasUserLoc ? distM(userLat, userLng, facility.latitude, facility.longitude) : null, features?.[facility.listing_id], openStatus?.[facility.listing_id], false);
        });

        list.innerHTML = html;
        list.classList.remove('opacity-0');
      }, 150);
    });
  }

  // Listen for updates
  window.addEventListener('facilitiesUpdated', updateListingLists);
  window.addEventListener('facilityListLoading', (e) => {
    if (e.detail.loading) {
      showLoadingSkeleton();
    }
  });
})();
</script>
