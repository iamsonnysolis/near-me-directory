---
// ScoreBar.astro - Horizontal bar showing 0-100 score
// Displays grade letter alongside (A for 70+, B for 45-69, C for <45)

interface Props {
  score: number | null | undefined;
  label?: string;
}

const { score, label } = Astro.props;

const grade = score === null || score === undefined ? '—' : score >= 70 ? 'A' : score >= 45 ? 'B' : 'C';
const barColor = score === null || score === undefined ? 'bg-gray-200' : score >= 70 ? 'bg-green-500' : score >= 45 ? 'bg-amber-500' : 'bg-red-500';
const textColor = score === null || score === undefined ? 'text-gray-400' : score >= 70 ? 'text-green-700' : score >= 45 ? 'text-amber-700' : 'text-red-700';
const percentage = score ?? 0;
---

<div class="flex items-center gap-2">
  {label && (
    <span class="text-sm text-gray-600 w-20">{label}</span>
  )}
  <div class="flex-1 bg-gray-100 rounded-full h-2 overflow-hidden">
    <div class={barColor + ' h-full transition-all'} style={'width: ' + percentage + '%'}></div>
  </div>
  <span class={'text-sm font-semibold min-w-[24px] ' + textColor}>{grade}</span>
</div>