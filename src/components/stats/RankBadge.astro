---
// RankBadge.astro - Rank badge showing #1, #2, #3, etc. with medal colors
// Props: rank (1-8), total (default 8 for states), entityType (for override)

import { ordinal } from '../../lib/stats-utils';

interface Props {
  rank: number | null | undefined;
  total?: number | null | undefined;
  entityType?: string;
}

const { rank, total, entityType } = Astro.props;

// Override rank_of to 8 for states (known data bug workaround)
const displayTotal = entityType === 'state' ? 8 : (total ?? 8);
const safeRank = rank ?? 0;
const rankText = safeRank > 0 ? ordinal(safeRank) : '—';

// Medal colors: #1 gold, #2 silver, #3 bronze, rest neutral
const rankColors: Record<number, string> = {
  1: 'bg-yellow-100 text-yellow-800',
  2: 'bg-gray-200 text-gray-800',
  3: 'bg-amber-100 text-amber-800',
};
const colorClass = safeRank > 0 && safeRank <= 3 ? rankColors[safeRank] : 'bg-gray-100 text-gray-800';

---

<span class={"font-bold rounded px-2 py-1 text-xs " + colorClass}>#{rankText} of {displayTotal}</span>