---
// DynamicLiveMap.astro
// Interactive client-side map for homepage
// - Loads markers dynamically on map move/zoom
// - Supports user geolocation with FAB button (bottom-right)
// - Uses Leaflet + CARTO tiles with marker clustering
// - Responds to filter changes from FilterBar
interface Props {
  initialLat?: number;
  initialLng?: number;
  initialZoom?: number;
}

const {
  initialLat = -25.2744,
  initialLng = 133.7751,
  initialZoom = 5,
} = Astro.props;

import Icon from '../ui/Icon.astro';
---

<div id="live-map-container" class="relative w-full h-full bg-gray-100">
  <!-- Geolocation FAB - bottom right of map -->
  <div class="absolute bottom-4 right-4 z-[800]">
    <button id="locate-me-btn" type="button" aria-label="Find my location" class="
          relative flex items-center justify-center
          w-11 h-11 rounded-full
          bg-white border-2 shadow-lg
          transition-all duration-200 active:scale-95
          border-gray-200 text-gray-600 hover:border-gray-300 hover:shadow-xl
        ">
      <Icon id="locate-icon" name="locateFixed" size={20} class="transition-opacity" />
      <Icon id="locate-spinner" name="loaderCircle" size={20} class="absolute hidden animate-spin opacity-0 transition-opacity" />
      <Icon id="locate-success" name="check" size={22} class="absolute hidden text-green-600" />
    </button>
  </div>
</div>

<style is:global>
  .tnm-live-marker,.nm-cluster,.marker-cluster { background:none!important;border:none!important;box-shadow:none!important; }
  .tnm-live-popup .leaflet-popup-content-wrapper { border-radius:16px!important;padding:0!important;box-shadow:0 8px 28px rgba(0,0,0,0.14)!important;border:1px solid #e5e7eb!important;overflow:hidden;min-width:240px;max-width:280px; }
  .tnm-live-popup .leaflet-popup-content { margin:0!important;width:100%!important; }
  .tnm-live-popup .leaflet-popup-tip-container { display:none!important; }
  .tnm-live-popup .leaflet-popup-close-button { top:12px!important;right:12px!important;font-size:20px!important;font-weight:300!important;color:#9ca3af!important;background:none!important;width:24px!important;height:24px!important;line-height:24px!important; }
  .tnm-live-popup .leaflet-popup-close-button:hover { color:#4b5563!important; }
  .marker-cluster-small,.marker-cluster-medium,.marker-cluster-large { background:none!important;border:none!important; }
  @media (max-width:768px){.leaflet-control-zoom{display:none!important;}}
  /* Location button pulse animation */
  .locating-pulse {
    animation: pulse-border 1.5s infinite;
  }
  @keyframes pulse-border {
    0% { box-shadow: 0 0 0 0 rgba(37, 99, 235, 0.4); }
    70% { box-shadow: 0 0 0 8px rgba(37, 99, 235, 0); }
    100% { box-shadow: 0 0 0 0 rgba(37, 99, 235, 0); }
  }
  .leaflet-control-attribution{font-size:10px!important;background:rgba(255,255,255,0.8)!important;border-radius:4px!important;padding:2px 6px!important;}
</style>

<script is:inline define:vars={{ initialLat, initialLng, initialZoom }}>
(() => {
  const C_BLUE = '#1d4ed8'; const C_WHITE = '#ffffff';

  let map = null; let clusterGroup = null; let userMarker = null; let currentMarkers = new Map();
  let isFetching = false; let lastBoundsKey = null; let isProgrammaticMove = false; let boundsDebounceTimer = null;
  let activeFilters = { features: [], h24: false, openNow: false };
  let userLocation = null;
  let pendingFilters = null;

  // Location button state management
  function setLocateButtonState(state) {
    const btn = document.getElementById('locate-me-btn');
    const icon = document.getElementById('locate-icon');
    const spinner = document.getElementById('locate-spinner');
    const success = document.getElementById('locate-success');
    
    if (!btn) return;
    
    // Reset all states
    btn.classList.remove('locating-pulse');
    if (icon) icon.classList.remove('opacity-0');
    if (spinner) spinner.classList.add('hidden');
    if (success) success.classList.add('hidden');
    
    if (state === 'loading') {
      btn.classList.add('locating-pulse', 'border-blue-400');
      if (icon) icon.classList.add('opacity-0');
      if (spinner) {
        spinner.classList.remove('hidden');
        spinner.classList.remove('opacity-0');
      }
    } else if (state === 'success') {
      if (icon) icon.classList.add('opacity-0');
      if (success) success.classList.remove('hidden');
      setTimeout(() => {
        if (icon) icon.classList.remove('opacity-0');
        if (success) success.classList.add('hidden');
      }, 1500);
    }
  }

  // Location caching functions (sessionStorage)
  function cacheUserLocation(lat, lng) {
    try {
      sessionStorage.setItem('tnm_user_location', JSON.stringify({
        lat, lng, timestamp: Date.now()
      }));
    } catch (e) {}
  }

  function getCachedUserLocation() {
    try {
      const cached = sessionStorage.getItem('tnm_user_location');
      if (!cached) return null;
      const { lat, lng, timestamp } = JSON.parse(cached);
      if (Date.now() - timestamp > 4 * 60 * 60 * 1000) {
        sessionStorage.removeItem('tnm_user_location');
        return null;
      }
      return { lat, lng };
    } catch (e) {
      return null;
    }
  }

  function createFacilityIcon() {
    return L.divIcon({
      html:'<div style="width:22px;height:22px;background:'+C_BLUE+';border-radius:50%;border:2.5px solid '+C_WHITE+';line-height:17px;text-align:center;font-weight:900;font-size:11px;color:'+C_WHITE+';box-shadow:0 2px 6px rgba(0,0,0,0.28);font-family:system-ui,-apple-system,BlinkMacSystemFont,sans-serif;cursor:pointer;">T</div>',
      className:'tnm-live-marker',iconSize:[22,22],iconAnchor:[11,11]
    });
  }

  function createUserIcon() {
    return L.divIcon({
      html:'<div style="width:16px;height:16px;background:#2563eb;border-radius:50%;border:3px solid '+C_WHITE+';box-shadow:0 0 0 5px rgba(37,99,235,0.2),0 2px 6px rgba(0,0,0,0.28);"></div>',
      className:'tnm-live-user',iconSize:[16,16],iconAnchor:[8,8]
    });
  }

  function createClusterIcon(count) {
    const size = count < 10 ? 34 : count < 50 ? 40 : 46;
    const lineHeight = Math.round(size - 5);
    return L.divIcon({
      html:'<div style="width:'+size+'px;height:'+size+'px;background:'+C_BLUE+';border-radius:50%;border:2.5px solid '+C_WHITE+';line-height:'+lineHeight+'px;text-align:center;font-weight:700;font-size:12px;color:'+C_WHITE+';box-shadow:0 2px 8px rgba(0,0,0,0.25);font-family:system-ui,-apple-system,BlinkMacSystemFont,sans-serif;">'+count+'</div>',
      className:'nm-cluster',iconSize:[size,size],iconAnchor:[size/2,size/2]
    });
  }

  function buildPopup(facility) {
      const stateSlug = (facility.state_code || 'nsw').toLowerCase();
      const detailUrl = facility.region_slug && facility.suburb_slug && facility.slug
        ? '/' + stateSlug + '/' + facility.region_slug + '/' + facility.suburb_slug + '/' + facility.slug : null;
      const CHEVRON_RIGHT = '<svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"></path></svg>';
      let html = '<div style="padding:16px;">';
      html += '<div style="font-size:15px;font-weight:800;color:#111827;line-height:1.2;margin-bottom:4px;padding-right:24px;">' + facility.name + '</div>';
      if (facility.address) html += '<div style="font-size:12px;color:#6b7280;line-height:1.4;margin-bottom:12px;">' + facility.address + '</div>';
      if (facility.is_open_24h) html += '<span style="display:inline-block;font-size:11px;font-weight:600;color:#15803c;background:#f0fdf4;border:1px solid #bbf7d0;border-radius:9999px;padding:2px 10px;margin-bottom:12px;">Open 24 hrs</span>';
      const buttonText = detailUrl ? 'View details' : 'View details and Directions';
      html += '<a href="' + (detailUrl || 'https://www.google.com/maps/dir/?api=1&destination=' + encodeURIComponent(facility.name)) + '"' + (detailUrl ? '' : ' target="_blank" rel="noopener noreferrer"') + ' style="display:flex;align-items:center;justify-content:center;width:100%;height:44px;background:#1d4ed8;color:#fff;font-size:14px;font-weight:700;border-radius:12px;text-decoration:none;transition:background 0.2s;" onmouseover="this.style.background=\'#1d4ed8\'" onmouseout="this.style.background=\'#1d4ed8\'">' + buttonText + CHEVRON_RIGHT + '</a></div>';
      return html;
    }

  function getBoundsKey(b) { return b.north.toFixed(3)+'-'+b.south.toFixed(3)+'-'+b.east.toFixed(3)+'-'+b.west.toFixed(3); }

  async function fetchFacilities(bounds) {
    if (isFetching) return;
    const boundsKey = getBoundsKey(bounds);
    if (boundsKey === lastBoundsKey) return;
    isFetching = true; lastBoundsKey = boundsKey;

    const params = new URLSearchParams({
      minLat: bounds.south.toFixed(6),
      maxLat: bounds.north.toFixed(6),
      minLng: bounds.west.toFixed(6),
      maxLng: bounds.east.toFixed(6)
    });
    
    // Add feature filters
    if (activeFilters.features.length > 0) {
      params.set('features', activeFilters.features.join(','));
    }
    // Add 24h filter
    if (activeFilters.h24) {
      params.set('h24', '1');
    }
    
    try {
      const res = await fetch('/api/listings?' + params.toString());
      if (!res.ok) return;
      updateMarkers(await res.json());
    } catch(e){console.error(e);}
    finally { isFetching = false; }
  }

  function fetchFacilitiesForCurrentBounds() {
    if (!map || isFetching) return;
    const bounds = map.getBounds();
    setLoading(true);
    fetchFacilities({north:bounds.getNorth(),south:bounds.getSouth(),east:bounds.getEast(),west:bounds.getWest()});
  }

  function updateMarkers(listings) {
    if (clusterGroup) clusterGroup.clearLayers();
    currentMarkers.clear();
    const valid = listings.filter(t => t.latitude && t.longitude);
    if (valid.length === 0) { setLoading(false); dispatchFacilityUpdate([]); return; }
    
    // Fetch features and open status FIRST
    Promise.all([
      fetchFeatures(valid.map(t => t.listing_id)),
      fetchOpenStatus(valid.map(t => t.listing_id))
    ])
    .then(([features, openStatus]) => {
      // Apply openNow filter BEFORE adding markers to map
      let toDisplay = valid;
      if (activeFilters.openNow && openStatus && Object.keys(openStatus).length > 0) {
        toDisplay = valid.filter(t => {
          const status = openStatus[t.listing_id];
          if (!status) return t.is_open_24h;
          return status.isOpen;
        });
      }
      
      // Add markers only for filtered listings
      toDisplay.forEach(t => {
        const m = L.marker([t.latitude,t.longitude],{icon:createFacilityIcon()});
        m.bindPopup(L.popup({closeButton:true,className:'tnm-live-popup',maxWidth:300,autoPanPadding:[20,20]}).setContent(buildPopup(t)));
        clusterGroup.addLayer(m);
        currentMarkers.set(t.listing_id,m);
      });
      
      setLoading(false);
      dispatchFacilityUpdate(toDisplay, features, openStatus);
    })
    .catch(() => dispatchFacilityUpdate(valid));
  }

  async function fetchFeatures(facilityIds) {
    if (!facilityIds || facilityIds.length === 0) return {};
    try {
      const res = await fetch('/api/features?ids=' + facilityIds.join(','));
      return res.ok ? await res.json() : {};
    } catch { return {}; }
  }

  async function fetchOpenStatus(facilityIds) {
    if (!facilityIds || facilityIds.length === 0) return {};
    try {
      // Send local time parameters (matches reference: useMapData.ts)
      const now = new Date();
      const jsDay = now.getDay();                            // 0=Sun, 1=Mon, ... 6=Sat
      const dow = (jsDay + 6) % 7;                           // Convert to 0=Mon ... 6=Sun
      const month = now.getMonth() + 1;                     // 1-12
      const mins = now.getHours() * 60 + now.getMinutes();  // 0-1439
      const res = await fetch('/api/open-status?ids=' + facilityIds.join(',') + '&dow=' + dow + '&month=' + month + '&mins=' + mins);
      return res.ok ? await res.json() : {};
    } catch { return {}; }
  }

  function dispatchFacilityUpdate(listings, features = {}, openStatus = {}) {
    window.dispatchEvent(new CustomEvent('facilitiesUpdated', {
      detail: { listings, features, openStatus, userLocation }
    }));
  }

  function setLoading(show) {
    window.dispatchEvent(new CustomEvent('facilityListLoading', { detail: { loading: show } }));
  }

  function handleGeolocationSuccess(pos) {
    setLocateButtonState('loading');
    const {latitude,longitude}=pos.coords;
    userLocation = { lat: latitude, lng: longitude };
    cacheUserLocation(latitude, longitude);
    isProgrammaticMove=true;
    if (map) map.flyTo([latitude,longitude],14,{duration:0.5});
    if (userMarker) userMarker.setLatLng([latitude,longitude]);
    else userMarker=L.marker([latitude,longitude],{icon:createUserIcon(),zIndexOffset:1000,interactive:false}).addTo(map);
  }

  function handleGeolocationError(err) {
    console.warn(err);
    const btn = document.getElementById('locate-me-btn');
    if (btn) {
      btn.classList.remove('locating-pulse');
      btn.classList.add('border-red-400');
      setTimeout(() => btn.classList.remove('border-red-400'), 800);
    }
  }

  // Listen for filter changes - registered immediately to catch events before map init
  window.addEventListener('filtersChanged', (e) => {
    const filters = e.detail.filters || {};
    activeFilters = {
      features: filters.features || [],
      h24: filters.is24Hours || false,
      openNow: filters.openNow || false
    };
    lastBoundsKey = null; // Clear cache to force refetch on filter change
    // If map is ready, fetch immediately; otherwise store as pending
    if (map) {
      fetchFacilitiesForCurrentBounds();
    } else {
      pendingFilters = true;
    }
  });

  function initMap() {
    const container=document.getElementById('live-map-container');
    if (!container || map) return;
    if (typeof L==='undefined' || typeof L.MarkerClusterGroup==='undefined') return;

    map=L.map(container,{center:[initialLat,initialLng],zoom:initialZoom,zoomControl:false,attributionControl:false});
    L.tileLayer('https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png',{attribution:'&copy; OpenStreetMap &copy; CARTO',subdomains:'abcd',maxZoom:20}).addTo(map);
    L.control.attribution({position:'bottomleft',prefix:false}).addTo(map);
    L.control.zoom({position:'topright'}).addTo(map);

    clusterGroup=L.markerClusterGroup({maxClusterRadius:45,showCoverageOnHover:false,disableClusteringAtZoom:17,spiderfyOnMaxZoom:true,iconCreateFunction:c=>createClusterIcon(c.getChildCount())}).addTo(map);

    const cachedLoc = getCachedUserLocation();
    if (cachedLoc) {
      userLocation = cachedLoc;
      map.flyTo([cachedLoc.lat, cachedLoc.lng], 14, {duration: 0.3});
      userMarker = L.marker([cachedLoc.lat, cachedLoc.lng], {icon: createUserIcon(), zIndexOffset: 1000, interactive: false}).addTo(map);
    }
    
    // Fetch with any pending filters applied
    const bounds=map.getBounds(); setLoading(true); fetchFacilities({north:bounds.getNorth(),south:bounds.getSouth(),east:bounds.getEast(),west:bounds.getWest()});

    map.on('moveend',()=>{ if (isProgrammaticMove){
        isProgrammaticMove=false;
        setTimeout(() => setLocateButtonState('success'), 300);
        fetchFacilitiesForCurrentBounds();
        return; } clearTimeout(boundsDebounceTimer); boundsDebounceTimer=setTimeout(fetchFacilitiesForCurrentBounds,300); });

    const locBtn=document.getElementById('locate-me-btn');
    if (locBtn) locBtn.addEventListener('click',()=>{ if ('geolocation' in navigator) navigator.geolocation.getCurrentPosition(handleGeolocationSuccess,handleGeolocationError,{enableHighAccuracy:true,timeout:10000}); });

    // If filters were changed before map was ready, the initial fetch already used them.
    // No need to fetch again - the filters are already applied via activeFilters.
    pendingFilters = false;
  }

  if (document.readyState==='loading') document.addEventListener('DOMContentLoaded',initMap);
  else { const check=()=>{ if (typeof L!=='undefined' && typeof L.MarkerClusterGroup!=='undefined') initMap(); else setTimeout(check,100); }; check(); }
})();
</script>